# ============================================================
# YAAWP Services Agency Operating System — Environment Template
# ============================================================

# --- Core Platform Variables (Injected by AI Studio / Cloud Run) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
PORT="3000"

# --- Production Administrator Credentials (REQUIRED for Production) ---
# Required for production deployments. If not set in production, default
# accounts are suppressed for security.
ADMIN_EMAIL="director@yaawp.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PRODUCTION_PASSWORD"

# --- Agency Notification Email Routing ---
# The receiving inbox where client project briefs and specialist applications arrive.
AGENCY_NOTIFICATION_EMAIL="director@yaawp.com"

# --- Server-Side Email Provider (Option 1: Resend) ---
# Resend API key for instant server-side email dispatch.
# Keep this strictly server-side (never expose to client code).
RESEND_API_KEY="re_123456789_abcdef"
EMAIL_FROM="YAAWP Agency <notifications@yaawp.com>"

# --- Server-Side Email Provider (Option 2: SMTP Relay) ---
# Alternatively configure standard SMTP credentials (Gmail App Password, SendGrid, Mailgun, Postmark, SES):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="agency-sender@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_SECURE="false"

# --- Environment Mode ---
# When set to production, fictional demo data and demo account helpers are omitted.
NODE_ENV="development"
DEMO_MODE="false"
